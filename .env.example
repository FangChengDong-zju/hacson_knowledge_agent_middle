# Copy this file to .env and adjust values for your machine/deployment.

APP_NAME=Hacson Knowledge Agent
APP_ENV=local

# Contest textbooks are stored outside the repository.
TEXTBOOK_DIR=E:/textbooks

# Optional cache generated during preparation. If present, local parsing uses it first.
CACHED_CHUNKS_PATH=E:/codex test/Preparation for Hacson/health_agent_demo/data/textbook_chunks.jsonl
CACHED_STATS_PATH=E:/codex test/Preparation for Hacson/health_agent_demo/reports/textbook_index_stats.json

# Optional OpenAI-compatible LLM settings.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_WIRE_API=chat

# Frontend dev origin.
FRONTEND_ORIGIN=http://localhost:5173
